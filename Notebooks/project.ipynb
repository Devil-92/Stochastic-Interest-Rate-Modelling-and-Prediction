      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Optimal Parameters :- kappa: 0.2537, theta: 0.0075, sigma: 0.0617\n",
            "\n",
            "Achieved Overall R²:   0.8759\n",
            "Overall RMSE:          0.002465\n",
            "Overall MAE:           0.001819\n"
