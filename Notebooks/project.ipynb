        "def check_cir_viability(df, name='Data'):\n",
        "    numeric_cols = df.select_dtypes(include=[np.number]).columns\n",
        "\n",
        "    print(f'\\n[{name}]')\n",
        "\n",
        "    # Check 1: Positivity\n",
        "    print('\\n1. POSITIVITY CHECK (CIR requires r_t > 0):')\n",
        "    all_positive = True\n",
        "    for col in numeric_cols:\n",
        "        min_val = df[col].min()\n",
        "        is_positive = min_val >= 0\n",
        "        all_positive &= is_positive\n",
        "        status = '✓' if is_positive else '✗'\n",
        "        print(f'  {status} {col}: min={min_val:.6f}')\n",
        "\n",
        "    # Check 2: Reasonable bounds\n",
        "    print('\\n2. BOUNDS CHECK (realistic range: [0, 0.3]):')\n",
        "    for col in numeric_cols:\n",
        "        min_val = df[col].min()\n",
        "        max_val = df[col].max()\n",
        "        in_bounds = (min_val >= 0) and (max_val <= 0.3)\n",
        "        status = '✓' if in_bounds else '⚠'\n",
        "        print(f'  {status} {col}: [{min_val:.6f}, {max_val:.6f}]')\n",
        "\n",
        "    # Check 3: Mean reversion signal\n",
        "    print('\\n3. MEAN REVERSION ANALYSIS:')\n",
        "    for col in numeric_cols:\n",
        "        mean = df[col].mean()\n",
        "        std = df[col].std()\n",
        "        cv = std / mean if mean > 0 else 0\n",
        "        print(f'  {col}: μ={mean:.6f}, σ={std:.6f}, CV={cv:.4f}')\n",
        "\n",
        "    # Check 4: Daily changes\n",
        "    print('\\n4. DAILY VOLATILITY:')\n",
        "    for col in numeric_cols:\n",
        "        daily_returns = df[col].pct_change().dropna()\n",
        "        max_change = daily_returns.abs().max()\n",
        "        mean_change = daily_returns.abs().mean()\n",
        "        print(f'  {col}: max_daily_pct_change={max_change:.4%}, mean={mean_change:.4%}')\n",
        "\n",
        "    # Check 5: No extreme gaps\n",
        "    print('\\n5. CONTINUITY CHECK (no extreme gaps after cleaning):')\n",
        "    for col in numeric_cols:\n",
        "        daily_change = df[col].diff().abs().dropna()\n",
        "        max_jump = daily_change.max()\n",
        "        p99 = daily_change.quantile(0.99)\n",
        "        print(f'  {col}: max_jump={max_jump:.6f}, 99th percentile={p99:.6f}')\n",
        "\n",
        "check_cir_viability(train_clean, 'TRAIN (after cleaning)')\n",
        "check_cir_viability(test_clean, 'TEST FULL CURVE (after cleaning)')\n",
        "check_cir_viability(test_3m_clean, 'TEST 3M RATE (after cleaning)')"
      ]
