        "### Step 1.3: Detect Outliers Using IQR Method"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 5,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "1vsHDETPQqvZ",
        "outputId": "9383977e-8669-46c3-ef4f-ded76d625237"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "OUTLIER DETECTION (IQR Method, threshold=1.5)\n",
            "\n",
            "[TRAIN DATA] Outliers per column:\n",
            "  3M: 394 outliers detected\n",
            "    Bounds: [-0.014115, 0.035849]\n",
            "  6M: 383 outliers detected\n",
            "    Bounds: [-0.016092, 0.040661]\n",
            "  9M: 327 outliers detected\n",
            "    Bounds: [-0.017993, 0.044520]\n",
            "  1Y: 184 outliers detected\n",
            "    Bounds: [-0.019791, 0.048263]\n",
            "\n",
            "Total outliers in train: 1288 (6.52% of data)\n"
          ]
        }
      ],
      "source": [
        "def detect_outliers_iqr(df, column, threshold=1.5, verbose=True):\n",
        "    \"\"\"Detect outliers using Interquartile Range (IQR) method.\"\"\"\n",
        "    Q1 = df[column].quantile(0.25)\n",
        "    Q3 = df[column].quantile(0.75)\n",
        "    IQR = Q3 - Q1\n",
        "    lower_bound = Q1 - threshold * IQR\n",
        "    upper_bound = Q3 + threshold * IQR\n",
        "    outlier_mask = (df[column] < lower_bound) | (df[column] > upper_bound)\n",
        "\n",
        "    if verbose and outlier_mask.sum() > 0:\n",
        "        print(f'  {column}: {outlier_mask.sum()} outliers detected')\n",
        "        print(f'    Bounds: [{lower_bound:.6f}, {upper_bound:.6f}]')\n",
        "\n",
        "    return outlier_mask, lower_bound, upper_bound\n",
        "\n",
        "print('OUTLIER DETECTION (IQR Method, threshold=1.5)')\n",
        "\n",
        "# Detect outliers in train data\n",
        "numeric_cols = train_raw.select_dtypes(include=[np.number]).columns.tolist()\n",
        "outlier_masks_train = {}\n",
        "\n",
        "print('\\n[TRAIN DATA] Outliers per column:')\n",
        "for col in numeric_cols:\n",
        "    mask, lb, ub = detect_outliers_iqr(train_raw, col, threshold=1.5)\n",
        "    outlier_masks_train[col] = mask\n",
        "\n",
        "total_outliers = sum(m.sum() for m in outlier_masks_train.values())\n",
        "print(f'\\nTotal outliers in train: {total_outliers} ({100*total_outliers/train_raw.size:.2f}% of data)')"
      ]
    },
