      "source": [
        "# Generate predictions for each test day\n",
        "predictions = np.zeros((len(test_3m_rates), len(test_maturities)))\n",
        "\n",
        "print(f\"Generating yield curve predictions for {len(test_3m_rates)} test days\")\n",
