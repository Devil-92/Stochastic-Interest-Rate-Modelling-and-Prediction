      "cell_type": "code",
      "execution_count": 17,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "EjA_Pb3oQqvd",
        "outputId": "ccef94e7-cdc2-4ceb-c6c1-32f10c5ad90c"
